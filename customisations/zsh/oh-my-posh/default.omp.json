{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "maps": {
    "user_name": {
        "jameswhyley": "🦄",
        "root": "💀"
      }
    },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "template": " {{ .UserName }} ",
          "foreground": "#ffffff",
          "background": "#86cff1",
          "type": "session",
          "style": "diamond",
          "background_templates": [
            "{{if contains \"💀\" .UserName}}#FF0000{{end}}"
          ]
        },
        {
          "options": {
            "folder_separator_icon": " \ue0b1 ",
            "home_icon": "~",
            "style": "folder"
          },
          "template": " \uea83 {{ .Path }} ",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b0",
          "background": "#47ff8a",
          "type": "path",
          "style": "powerline",
          "background_templates": [
            "{{if contains \"terraform/azure\" .Location}}#9ec3f0{{end}}",
            "{{if contains \"terraform/layers\" .Location}}#FFA400{{end}}"
          ]
        },
        {
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "foreground": "#193549",
          "powerline_symbol": "\ue0b0",
          "background": "#fffb38",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF9248{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff4500{{ end }}",
            "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
            "{{ if gt .Behind 0 }}#B388FF{{ end }}"
          ]
        },
        {
          "options": {
            "display_default": false
          },
          "template": " \ue7ad {{ .Profile }} ",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b0",
          "type": "aws",
          "style": "powerline",
          "background_templates": [
            "{{if contains \"engineer\" .Profile}}#FFA400{{end}}{{if contains \"plan\" .Profile}}#FFA400{{end}}{{if contains \"readonly\" .Profile}}#FFA400{{end}}",
            "{{if .Profile}}#f1184c{{end}}"
          ]
        },
        {
          "type": "az",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#000000",
          "background": "#9ec3f0",
          "template": "  {{ .Name }} ",
          "options": {
            "source": "cli",
            "display_default": false
          }
        },
        {
          "options": {
            "always_enabled": true
          },
          "template": "<transparent>\ue0b0</> \ueba2 {{ .FormattedMs }}\u2800",
          "foreground": "#ffffff",
          "background": "#83769c",
          "type": "executiontime",
          "style": "plain"
        },
        {
          "options": {
            "always_enabled": true
          },
          "trailing_diamond": "\ue0b4",
          "template": "<parentBackground>\ue0b0</> \ue23a ",
          "foreground": "#ffffff",
          "background": "#00897b",
          "type": "status",
          "style": "diamond",
          "background_templates": [
            "{{ if gt .Code 0 }}#e91e63{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "template": "<#0077c2,transparent>\ue0b6</> \uf489 {{ .Name }} <transparent,#0077c2>\ue0b2</>",
          "foreground": "#ffffff",
          "background": "#0077c2",
          "type": "shell",
          "style": "plain"
        },
        {
          "options": {
            "paused_icon": "\uf04c ",
            "playing_icon": "\uf04b "
          },
          "template": " \uf167 {{ .Icon }}{{ if ne .Status \"stopped\" }}{{ .Artist }} - {{ .Track }}{{ end }} ",
          "foreground": "#111111",
          "powerline_symbol": "\ue0b2",
          "background": "#1BD760",
          "type": "spotify",
          "style": "powerline",
          "invert_powerline": true
        },
        {
          "type": "ipify",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "\ue0b4",
          "foreground": "#111111",
          "background": "#f36943",
          "template": " {{ .IP }} ",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "options": {
            "http_timeout": 1000
          }
        }
      ]
    }
  ],
  "version": 4,
  "final_space": true
}

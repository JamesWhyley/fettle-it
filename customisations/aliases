alias and="profile analytics dev"
alias an="prof analytics-plan"
alias aua="prof prod-au"
alias au="prof prod-au-plan"
alias caa="prof prod-ca"
alias ca="prof prod-ca-plan"
alias con="prof connectors"
alias dea="prof prod-de"
alias de="prof prod-de-plan"
alias gbla="prof prod-global"
alias gbl="prof prod-global-plan"
alias lega="prof legacy"
alias loca="prof local"
alias mgmta="prof management"
alias mgmt="prof management-plan"
alias npa="prof nonprod"
alias np="prof nonprod-plan"
alias orga="prof organization"
alias org="prof organization-plan"
alias prof="aws-profile-selector"
alias sand="prof sandbox1"
alias sga="prof prod-sg"
alias sg="prof prod-sg-plan"
alias uka="prof prod-uk"
alias uk="prof prod-uk-plan"
